{
  "manifest_version": 3,
  "name": "HPC Assist - Portal Sync & Automation",
  "version": "1.2.1",
  "description": "UDISE+ student data sync and PARAKH HPC portal automated submission & 15-part teacher evaluation assistant.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://sdms.udiseplus.gov.in/*",
    "https://hpc.parakh.ncert.gov.in/*",
    "https://ctetmonktest.fun/*",
    "http://127.0.0.1:8000/*",
    "http://127.0.0.1/*",
    "http://localhost:8000/*",
    "http://localhost/*"
  ],
  "action": {
    "default_title": "HPC Assist Portal Assistant"
  },
  "content_scripts": [
    {
      "matches": [
        "https://sdms.udiseplus.gov.in/*"
      ],
      "js": [
        "config.js",
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://hpc.parakh.ncert.gov.in/*"
      ],
      "js": [
        "config.js",
        "hpc_content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://ctetmonktest.fun/*",
        "http://127.0.0.1:8000/*",
        "http://127.0.0.1/*",
        "http://localhost:8000/*",
        "http://localhost/*"
      ],
      "js": [
        "dashboard_bridge.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
